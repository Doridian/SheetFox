  "patterns": [],
  "calculators": [
   {
    "id": "pulse",
    "title": "Pulse energy & peak power",
    "description": "Where your pulse width / frequency sits relative to the cut-off frequency determines whether you get full average power or full peak power.",
    "inputs": [
     "pw",
     "prr",
     "power_set",
     "p_rated"
    ],
    "outputs": [
     {
      "id": "f_cutoff",
      "label": "Cut-off frequency",
      "unit": "kHz",
      "expr": "tlookup(\"cutoff\", \"pw\", pw, \"fc_khz\")",
      "format": "fixed0",
      "description": null
     },
     {
      "id": "f_max",
      "label": "Max pulse frequency",
      "unit": "kHz",
      "expr": "tlookup(\"cutoff\", \"pw\", pw, \"fmax_khz\")",
      "format": "fixed0",
      "description": null
     },
     {
      "id": "derate",
      "label": "Frequency derating factor",
      "unit": null,
      "expr": "min(1, prr / f_cutoff)",
      "format": "fixed3",
      "description": "1 above cut-off; f/f_c below it (Figure 3)."
     },
     {
      "id": "p_out",
      "label": "Average output power",
      "unit": "W",
      "expr": "p_rated * power_set / 100 * derate",
      "format": "fixed1",
      "description": "Assumes output ∝ power setting; the manual warns that it isn't exactly linear."
     },
     {
      "id": "e_pulse",
      "label": "Pulse energy",
      "unit": "mJ",
      "expr": "p_out / prr",
      "format": "fixed3",
      "description": "E = P / f  (W / kHz = mJ)"
     },
     {
      "id": "p_peak_rect",
      "label": "Peak power (rectangular est.)",
      "unit": "kW",
      "expr": "e_pulse / pw * 1000",
      "format": "fixed2",
      "description": "E / τ – a rectangular-pulse estimate."
     },
     {
      "id": "p_peak_fig4",
      "label": "Peak power (from Figure 4)",
      "unit": "kW",
      "expr": "tlookup(\"cutoff\", \"pw\", pw, \"peak_fig4_kw\") * power_set / 100 * min(1, f_cutoff / prr)",
      "format": "fixed2",
      "description": "Measured waveform peak at f_c scaled by energy ratio f_c/f above cut-off (peak is held constant below it). Better than E/τ for the spiky short pulses."
     },
     {
      "id": "duty",
      "label": "Optical duty cycle",
      "unit": "%",
      "expr": "prr * 1e3 * pw * 1e-9 * 100",
      "format": "fixed3",
      "description": null
     }
    ],
    "page": 10
   },
   {
    "id": "optics",
    "title": "Spot size, fluence & intensity",
    "description": null,
    "inputs": [
     "focal_len",
     "beam_dia"
    ],
    "outputs": [
     {
      "id": "spot_d",
      "label": "Focused spot diameter (1/e²)",
      "unit": "µm",
      "expr": "4 * spec.m2.max * 1.064 * focal_len / (pi * beam_dia)",
      "format": "fixed1",
      "description": "d = 4·M²·λ·F / (π·D) using M² = 1.5 (spec max) and λ = 1064 nm."
     },
     {
      "id": "spot_area",
      "label": "Spot area",
      "unit": "cm²",
      "expr": "pi * (spot_d * 1e-4 / 2)^2",
      "format": "sci",
      "description": null
     },
     {
      "id": "fluence",
      "label": "Peak fluence (top-hat est.)",
      "unit": "J/cm²",
      "expr": "e_pulse * 1e-3 / spot_area",
      "format": "fixed2",
      "description": "Pulse energy over spot area. A Gaussian beam's on-axis fluence is 2× this."
     },
     {
      "id": "intensity",
      "label": "Peak intensity",
      "unit": "W/cm²",
      "expr": "p_peak_fig4 * 1e3 / spot_area",
      "format": "sci",
      "description": null
     },
     {
      "id": "rayleigh",
      "label": "Rayleigh range (≈ half depth of focus)",
      "unit": "mm",
      "expr": "pi * (spot_d / 2)^2 / (1.064 * spec.m2.max) / 1000",
      "format": "fixed2",
      "description": null
     }
    ],
    "page": null
   },
   {
    "id": "process",
    "title": "Marking: pulse spacing & overlap",
    "description": null,
    "inputs": [
     "mark_speed",
     "prr"
    ],
    "outputs": [
     {
      "id": "pulse_spacing",
      "label": "Pulse-to-pulse spacing",
      "unit": "µm",
      "expr": "mark_speed / prr",
      "format": "fixed2",
      "description": "v / f  (mm/s ÷ kHz = µm)"
     },
     {
      "id": "overlap",
      "label": "Spot overlap",
      "unit": "%",
      "expr": "(1 - pulse_spacing / spot_d) * 100",
      "format": "fixed1",
      "description": null
     },
     {
      "id": "speed_for_50",
      "label": "Speed for 50 % overlap",
      "unit": "mm/s",
      "expr": "0.5 * spot_d * prr",
      "format": "fixed0",
      "description": null
     }
    ],
    "page": null
   },
   {
    "id": "power_io",
    "title": "DB25 power code & supply",
    "description": null,
    "inputs": [
     "power_set",
     "v_supply"
    ],
    "outputs": [
     {
      "id": "power_code",
      "label": "DB25 power code (pins 8…1)",
      "unit": null,
      "expr": "round(power_set / 100 * 255)",
      "format": "hex",
      "description": "PIN 8 = MSB, PIN 1 = LSB"
     },
     {
      "id": "power_code_dec",
      "label": "Power code (decimal)",
      "unit": null,
      "expr": "round(power_set / 100 * 255)",
      "format": "int",
      "description": null
     },
     {
      "id": "i_supply_max",
      "label": "Supply current at max consumption",
      "unit": "A",
      "expr": "spec.p_cons.max / v_supply",
      "format": "fixed1",
      "description": null
     },
     {
      "id": "wallplug",
      "label": "Wall-plug efficiency (lower bound)",
      "unit": "%",
      "expr": "p_out / spec.p_cons.max * 100",
      "format": "fixed1",
      "description": null
     },
     {
      "id": "heat",
      "label": "Heat to remove (upper bound)",
      "unit": "W",
      "expr": "spec.p_cons.max - p_out",
      "format": "fixed0",
      "description": null
     }
    ],
    "page": 16
   }
  ],
  "checks": [
   {
    "id": "prr_over_max",
    "severity": "error",
    "when": "prr > f_max",
    "message": "Repetition rate exceeds the maximum pulse frequency for this pulse width (Table 5)."
   },
   {
    "id": "prr_range",
    "severity": "error",
    "when": "prr < spec.prr_range.min or prr > spec.prr_range.max",
    "message": "Repetition rate outside the 1–4000 kHz range."
   },
   {
    "id": "below_cutoff",
