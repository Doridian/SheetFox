  "calculators": [
   {
    "id": "match",
    "title": "Match at operating frequency",
    "description": "Looks up the digitized S11 graph and converts it to VSWR, return loss and mismatch loss.",
    "inputs": [
     "f_mhz"
    ],
    "outputs": [
     {
      "id": "s11_db",
      "label": "S11 at f",
      "unit": "dB",
      "expr": "curve(\"s11_868\", f_mhz)",
      "format": "fixed2",
      "description": "Digitized evaluation-board S11 (dB(S(1,1))) at the operating frequency."
     },
     {
      "id": "rl_db",
      "label": "Return loss",
      "unit": "dB",
      "expr": "-s11_db",
      "format": "fixed2",
      "description": null
     },
     {
      "id": "gamma_mag",
      "label": "|Γ| (reflection coefficient)",
      "unit": null,
      "expr": "10^(s11_db/20)",
      "format": "fixed3",
      "description": null
     },
     {
      "id": "vswr",
      "label": "VSWR",
      "unit": null,
      "expr": "(1 + gamma_mag)/(1 - gamma_mag)",
      "format": "fixed2",
      "description": "VSWR = (1+|Γ|)/(1−|Γ|)"
     },
     {
      "id": "mismatch_loss_db",
      "label": "Mismatch loss",
      "unit": "dB",
      "expr": "-10*log10(1 - gamma_mag^2)",
      "format": "fixed3",
      "description": "ML = −10·log10(1−|Γ|²): power reflected back to the transmitter."
     },
     {
      "id": "p_reflected_pct",
      "label": "Reflected power",
      "unit": "%",
      "expr": "100*gamma_mag^2",
      "format": "fixed2",
      "description": null
     },
     {
      "id": "mismatch_loss_ref_db",
      "label": "Mismatch loss at 868 MHz (pattern frequency)",
      "unit": "dB",
      "expr": "-10*log10(1 - 10^(curve(\"s11_868\", 868)/10))",
      "format": "fixed3",
      "description": "Mismatch at the frequency where the radiation patterns were measured; used to estimate the extra loss when operating off 868 MHz."
     },
     {
      "id": "excess_mismatch_db",
      "label": "Extra mismatch vs pattern frequency",
      "unit": "dB",
      "expr": "max(0, mismatch_loss_db - mismatch_loss_ref_db)",
      "format": "fixed3",
      "description": "Derived (not in datasheet): additional mismatch loss relative to the frequency of the pattern measurement. Gains below are reduced by this amount."
     }
    ],
    "page": 4
   },
   {
    "id": "direction",
    "title": "Directional gain",
    "description": null,
    "inputs": [
     "cut",
     "angle_deg"
    ],
    "outputs": [
     {
      "id": "g_dir_dbi",
      "label": "Gain toward chosen direction",
      "unit": "dBi",
      "expr": "pattern(\"pat_868\", cut, angle_deg)",
      "format": "fixed2",
      "description": "Interpolated from the digitized 868 MHz pattern."
     },
     {
      "id": "g_cut_peak_dbi",
      "label": "Peak gain in selected cut",
      "unit": "dBi",
      "expr": "tindex(\"cut_summary\", \"cut_idx\", cut, \"peak\")",
      "format": "fixed2",
      "description": null
     },
     {
      "id": "g_rel_peak_db",
      "label": "Relative to cut peak",
      "unit": "dB",
      "expr": "g_dir_dbi - g_cut_peak_dbi",
      "format": "fixed2",
      "description": null
     },
     {
      "id": "g_peak_dbi",
      "label": "Peak gain (all cuts / datasheet)",
      "unit": "dBi",
      "expr": "max(spec.peak_gain.typ, tindex(\"cut_summary\", \"cut_idx\", 0, \"peak\"), tindex(\"cut_summary\", \"cut_idx\", 1, \"peak\"), tindex(\"cut_summary\", \"cut_idx\", 2, \"peak\"))",
      "format": "fixed2",
      "description": "Larger of the datasheet peak gain and the highest digitized pattern value."
     }
    ],
    "page": 4
   },
   {
    "id": "link",
    "title": "EIRP / ERP and free-space link budget",
    "description": "Derived physics (Friis free-space model). Gains are the datasheet's EVB measurements; a different board/enclosure will change them.",
    "inputs": [
     "p_tx_dbm",
     "loss_db",
     "rx_gain_dbi",
     "sens_dbm",
     "req_margin_db",
     "dist_m",
     "f_mhz"
    ],
    "outputs": [
     {
      "id": "p_ant_dbm",
      "label": "Power delivered to antenna port",
      "unit": "dBm",
      "expr": "p_tx_dbm - loss_db",
      "format": "fixed2",
      "description": "TX power minus cable/matching loss."
     },
     {
      "id": "eirp_dbm",
      "label": "EIRP toward chosen direction",
      "unit": "dBm",
      "expr": "p_ant_dbm + g_dir_dbi - excess_mismatch_db",
      "format": "fixed2",
      "description": "EIRP = P_TX − L_cable + G(θ) − extra mismatch (derived)."
     },
     {
      "id": "eirp_mw",
      "label": "EIRP",
      "unit": "mW",
      "expr": "1000*dbm2w(eirp_dbm)",
      "format": "fixed3",
      "description": null
     },
     {
      "id": "erp_dbm",
      "label": "ERP toward chosen direction",
      "unit": "dBm",
      "expr": "eirp_dbm - 2.15",
      "format": "fixed2",
      "description": "ERP = EIRP − 2.15 dB (relative to a half-wave dipole)."
     },
     {
      "id": "erp_mw",
      "label": "ERP",
      "unit": "mW",
      "expr": "1000*dbm2w(erp_dbm)",
      "format": "fixed3",
      "description": null
     },
     {
      "id": "eirp_max_dbm",
      "label": "Worst-case EIRP (peak gain)",
      "unit": "dBm",
      "expr": "p_ant_dbm + g_peak_dbi - excess_mismatch_db",
      "format": "fixed2",
      "description": "EIRP using the highest gain in any measured cut (or the datasheet peak gain if higher) – what a regulator would measure."
     },
     {
      "id": "erp_max_dbm",
      "label": "Worst-case ERP (peak gain)",
      "unit": "dBm",
      "expr": "eirp_max_dbm - 2.15",
      "format": "fixed2",
      "description": null
     },
     {
      "id": "erp_max_mw",
      "label": "Worst-case ERP",
      "unit": "mW",
      "expr": "1000*dbm2w(erp_max_dbm)",
      "format": "fixed3",
      "description": null
     },
     {
      "id": "fspl_db",
      "label": "Free-space path loss",
      "unit": "dB",
      "expr": "20*log10(dist_m/1000) + 20*log10(f_mhz) + 32.44",
      "format": "fixed2",
      "description": "FSPL = 20·log10(d_km) + 20·log10(f_MHz) + 32.44 (Friis)."
     },
     {
      "id": "prx_dbm",
      "label": "Received power",
      "unit": "dBm",
      "expr": "eirp_dbm - fspl_db + rx_gain_dbi",
      "format": "fixed2",
      "description": null
     },
     {
      "id": "link_margin_db",
      "label": "Link margin",
      "unit": "dB",
      "expr": "prx_dbm - sens_dbm",
      "format": "fixed2",
      "description": "Received power above receiver sensitivity."
     },
     {
      "id": "range_max_m",
      "label": "Max free-space range (with required margin)",
      "unit": "m",
      "expr": "1000*10^((eirp_dbm + rx_gain_dbi - sens_dbm - req_margin_db - 32.44 - 20*log10(f_mhz))/20)",
      "format": "fixed0",
      "description": "Distance where the margin equals the required fade margin, solving the FSPL formula for d. Real-world range (ground reflection, obstacles, body loss) is usually much shorter."
     },
     {
      "id": "erp_headroom_db",
      "label": "Headroom to selected ERP limit (worst case)",
      "unit": "dB",
      "expr": "erp_limit_dbm - erp_max_dbm",
      "format": "fixed2",
      "description": null
     },
     {
      "id": "p_tx_max_for_limit_dbm",
      "label": "Max TX power for selected ERP limit",
      "unit": "dBm",
      "expr": "erp_limit_dbm + 2.15 - g_peak_dbi + loss_db + excess_mismatch_db",
      "format": "fixed2",
      "description": null
     }
    ],
    "page": null
   }
  ],
  "checks": [
   {
    "id": "f_off_graph",
    "severity": "error",
    "when": "isNaN(s11_db)",
    "message": "Frequency is outside the 500–1300 MHz range of the datasheet's S11 graph."
   },
   {
    "id": "f_out_of_band",
    "severity": "warning",
    "when": "not isNaN(s11_db) and not between(f_mhz, spec.freq_min.min, spec.freq_max.max)",
    "message": "Frequency is outside the specified 858–878 MHz band; return loss and gain are not guaranteed (patterns were only measured at 868 MHz)."
   },
   {
    "id": "vswr_high",
    "severity": "warning",
    "when": "vswr > 2",
    "message": "VSWR above 2:1 (return loss < 9.5 dB): more than ~11 % of the power is reflected; retune the matching network."
   },
   {
    "id": "rl_below_spec",
    "severity": "info",
    "when": "rl_db < spec.return_loss.min and vswr <= 2",
    "message": "Return loss is below the 9.5 dB datasheet minimum at this frequency."
   },
   {
    "id": "power_over_max",
    "severity": "error",
    "when": "p_ant_dbm > 10*log10(spec.power_max.max*1000)",
    "message": "Power at the antenna exceeds the 2 W CW power capacity (33 dBm)."
   },
   {
    "id": "erp_over_limit",
    "severity": "error",
    "when": "erp_max_dbm > erp_limit_dbm",
    "message": "Worst-case ERP exceeds the selected regulatory limit; reduce TX power or add attenuation."
   },
   {
    "id": "srd_g1_limit",
    "severity": "warning",
    "when": "between(f_mhz, 868, 868.6) and erp_max_dbm > 14",
    "message": "868.0–868.6 MHz: EU SRD (ERC/REC 70-03 Annex 1 band h1.4, EN 300 220) allows max. 25 mW ERP (14 dBm), 1 % duty cycle."
   },
   {
    "id": "near_field",
    "severity": "info",
    "when": "dist_m < 0.7",
    "message": "Distance is within ~2λ of an 868 MHz antenna (λ ≈ 0.35 m); the far-field FSPL formula is not valid there."
   },
   {
    "id": "margin_negative",
    "severity": "error",
    "when": "link_margin_db < 0",
    "message": "Received power is below the receiver sensitivity at this distance – the link will not close even in free space."
   },
   {
    "id": "margin_low",
    "severity": "warning",
    "when": "link_margin_db >= 0 and link_margin_db < req_margin_db",
    "message": "Link margin is below the required fade margin; expect dropouts from fading, body loss and obstacles."
   }
  ],
  "notes": [
   "All RF data were measured on Johanson's 40 × 20 mm evaluation board (P/N 0868AT43A0020001CE1) with a 3.9 pF / 18 nH / 0.3 pF pi match; gain, efficiency and tuning will differ on your PCB, ground plane size and enclosure. Leave pads for a pi network and retune.",
   "Typical values are averages at 25 °C; min/max values are over the −40…+85 °C operating range (datasheet footnote 1).",
   "Place the antenna at a PCB end or corner over the specified ground clearance; ground vias along the feed are strongly recommended for efficiency (p.3, p.5).",
   "Radiation patterns digitized from small raster-like polar plots (≈0.5 dB reading accuracy); the plots carry a single (total) gain trace per cut, labelled 'dB'.",
   "The 'extra mismatch' correction is a SheetFox estimate: it reduces the 868 MHz pattern gain by the additional mismatch loss at off-centre frequencies; it ignores the change of radiation efficiency with frequency, which the datasheet does not give.",
   "ERP = EIRP − 2.15 dB. Regulatory checks use the worst-case (peak) gain, not the gain toward the chosen direction."
  ]
 },
 "userState": null
}
