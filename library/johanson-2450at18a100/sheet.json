   {
    "id": "vswr_reference",
    "title": "VSWR ↔ return loss ↔ mismatch loss",
    "page": null,
    "description": "Reference conversions (standard transmission-line relations, not from the datasheet). Edit the VSWR column.",
    "columns": [
     {
      "id": "vswr",
      "label": "VSWR",
      "unit": null,
      "kind": "data",
      "expr": null,
      "format": null
     },
     {
      "id": "gamma",
      "label": "|Γ|",
      "unit": null,
      "kind": "computed",
      "expr": "(row.vswr - 1)/(row.vswr + 1)",
      "format": "fixed3"
     },
     {
      "id": "rl",
      "label": "Return loss",
      "unit": "dB",
      "kind": "computed",
      "expr": "-20*log10(row.gamma)",
      "format": "fixed2"
     },
     {
      "id": "ml",
      "label": "Mismatch loss",
      "unit": "dB",
      "kind": "computed",
      "expr": "-10*log10(1 - row.gamma^2)",
      "format": "fixed3"
