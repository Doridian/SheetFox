{
  "name": "sheetfox",
  "version": "1.0.0",
  "description": "Interactive datasheet player",
  "scripts": {
    "predev": "tsx ingest/build-index.ts",
    "dev": "vite",
    "prebuild": "tsx ingest/build-index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "ingest": "tsx ingest/ingest.ts",
    "validate": "tsx ingest/validate.ts",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit",
    "index": "tsx ingest/build-index.ts",
    "lint": "eslint --report-unused-disable-directives --cache --color . && prettier --check .",
    "fmt": "eslint --fix . && prettier --write .",
    "test": "echo 'No tests yet'"
  },
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "mathjs": "^15.2.0",
    "plotly.js-dist-min": "^4.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/plotly.js": "^3.0.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.8"
  },
  "private": true
}
